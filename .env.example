# SINDARIS Terminal использует PostgreSQL через Drizzle ORM + node-postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Секретный ключ доступа к терминалу SINDARIS.
# Сессия после успешной авторизации действует 8 часов.
ACCESS_TOKEN=sindaris

# Необязательно: несколько токенов доступа через JSON-массив строк.
# ACCESS_TOKENS_JSON=["sindaris","officer-key"]
